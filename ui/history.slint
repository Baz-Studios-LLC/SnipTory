import { ScrollView } from "std-widgets.slint";
import { OptionsPanel } from "options.slint";
export { TrayMenu } from "tray.slint";
export { RecordingBar } from "recording.slint";

export struct CaptureItem {
    id: string,
    preview: image,
    label: string,
    dimensions: string,
    animated: bool,
}

component HeaderButton inherits TouchArea {
    in property <image> glyph;
    in property <bool> active;
    width: 28px;
    height: 28px;
    mouse-cursor: pointer;
    z: 1;
    Rectangle {
        border-radius: 7px;
        background: root.active ? #1d304a : root.has-hover ? #2a2f39 : transparent;
        Image { x: 5px; y: 5px; width: 18px; height: 18px; source: root.glyph; colorize: root.active ? #8ab6ed : #939cad; }
    }
}

export component HistoryWindow inherits Window {
    title: "SnipTory";
    preferred-width: 496px;
    preferred-height: 648px;
    min-width: 420px;
    min-height: 360px;
    no-frame: true;
    always-on-top: true;
    icon: @image-url("../assets/sniptory.png");
    background: #111419;
    in property <string> ui-font-family: "Segoe UI Variable Text";
    default-font-family: root.ui-font-family;
    in property <bool> native-title-drag;
    in property <bool> gif-recording-supported: true;
    in property <string> shortcut-help: "Type a combination, e.g. Ctrl+Shift+S.\nUse Ctrl, Alt or Win with a letter, number or F1–F24.";
    callback drag-window();
    default-font-size: 12px;
    in property <[CaptureItem]> captures;
    in property <string> status: "Ready";
    in property <bool> has-more;
    in-out property <int> selected: -1;
    in-out property <int> hovered: -1;
    in-out property <bool> history-busy;
    in-out property <bool> confirming;
    private property <bool> clear-requested;
    private property <string> pending-delete-id;
    callback preview(int);
    callback delete-entry(string);
    callback clear-history();
    callback capture();
    callback dismiss();
    callback paste(int);
    callback more();
    callback navigate(string);
    callback refresh-gallery();
    callback update-action();
    callback check-updates();
    in property <string> release-version: "v014";
    in property <string> update-label: "Check for updates";
    in property <string> update-detail: "";
    in property <bool> update-busy;
    in-out property <bool> show-options;
    in-out property <bool> launch-at-sign-in;
    in-out property <bool> automatic-updates: true;
    in-out property <bool> paste-on-select: true;
    callback setting-changed(string, bool);
    callback view-capture(int);
    callback configure-shortcuts(string,string,string,string);
    in-out property <string> screenshot-hotkey: "Alt+Shift+S";
    in-out property <string> history-hotkey: "Alt+Shift+V";
    in-out property <string> full-hotkey: "Alt+Shift+F";
    in-out property <string> gif-hotkey: "Alt+Shift+G";
    in-out property <bool> shortcuts-busy;
    in-out property <string> shortcut-detail;
    callback open-folder();
    callback tray-menu();
    callback restart-app();

    focus := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape { if root.confirming {root.confirming = false;} else {root.dismiss();} return accept; }
            if root.confirming { if event.text == Key.Return {root.accept-deletion();} return accept; }
            if root.show-options {return reject;}
            if event.text == Key.Delete && root.selected >= 0 && !root.history-busy { root.request-delete(root.selected); return accept; }
            if event.text == Key.Return { if root.selected >= 0 && !root.history-busy { root.paste(root.selected); } return accept; }
            if event.text == Key.LeftArrow { root.navigate("left"); return accept; }
            if event.text == Key.RightArrow { root.navigate("right"); return accept; }
            if event.text == Key.UpArrow { root.navigate("up"); return accept; }
            if event.text == Key.DownArrow { root.navigate("down"); return accept; }
            return reject;
        }
    }
    public function prepare() { root.confirming = false; focus.focus(); }
    public function request-delete(index: int) {
        if index >= 0 && index < root.captures.length && !root.history-busy {
            root.pending-delete-id = root.captures[index].id; root.clear-requested = false; root.confirming = true; root.preview(-1); root.hovered = -1;
        }
    }
    public function request-clear() {
        if !root.history-busy {root.clear-requested = true; root.pending-delete-id = ""; root.confirming = true; root.preview(-1); root.hovered = -1;}
    }
    function accept-deletion() {
        root.confirming = false; root.history-busy = true;
        if root.clear-requested {root.clear-history();} else {root.delete-entry(root.pending-delete-id);}
    }

    Rectangle {
        border-radius: 12px;
        border-color: #353b47;
        border-width: 1px;
        background: #111419;
        VerticalLayout {
            padding: 0px;
            spacing: 0px;
            Rectangle {
                height: 73px;
                if root.native-title-drag : TouchArea {
                    width: parent.width - 100px; height: parent.height;
                    pointer-event(event) => {if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {root.drag-window();}}
                }
                // Native WM_NCHITTEST limits dragging to this 73px title bar.
                // No TouchArea overlays the gallery or its header buttons.
                    Rectangle {
                        x: 22px; y: 20px;
                        width: 33px; height: 33px; border-radius: 10px;
                        background: #162f55;
                        Image { source: @image-url("icons/capture.svg"); width: 21px; height: 21px; x: 6px; y: 6px; colorize: #f1f6ff; }
                    }
                    Text { x: 66px; y: 16px; height: 25px; text: "SnipTory"; font-size: 18px; font-weight: 700; color: #f2f3f8; }
                    Text { x: 66px; y: 43px; height: 13px; text: "CAPTURE. RECALL. PASTE."; font-size: 9px; letter-spacing: 1.1px; color: #777f90; }
                    HeaderButton {
                        x: parent.width - 78px; y: 22px;
                        glyph: @image-url("icons/gear.svg");
                        active: root.show-options;
                        clicked => { root.show-options = !root.show-options; }
                    }
                    HeaderButton {
                        x: parent.width - 44px; y: 22px;
                        glyph: @image-url("icons/close.svg");
                        clicked => { root.dismiss(); }
                    }
            }
            Rectangle { height: 1px; background: #262b34; }
            if root.show-options : OptionsPanel {
                launch-at-sign-in <=> root.launch-at-sign-in;
                automatic-updates <=> root.automatic-updates;
                paste-on-select <=> root.paste-on-select;
                screenshot-hotkey: root.screenshot-hotkey;
                history-hotkey: root.history-hotkey;
                full-hotkey: root.full-hotkey;
                gif-hotkey: root.gif-hotkey;
                shortcuts-busy: root.shortcuts-busy;
                shortcut-detail: root.shortcut-detail;
                gif-recording-supported: root.gif-recording-supported;
                shortcut-help: root.shortcut-help;
                configure-shortcuts(s,h,f,g) => {root.shortcuts-busy = true;root.shortcut-detail = "Saving shortcuts…";root.configure-shortcuts(s,h,f,g);}
                update-label: root.update-label;
                update-busy: root.update-busy;
                update-detail: root.update-detail;
                back => { root.show-options = false; }
                changed-setting(key,value) => { root.setting-changed(key,value); }
                open-folder => { root.open-folder(); }
                restart => { root.restart-app(); }
                update => { root.update-action(); }
                history-busy: root.history-busy;
                clear-history => {root.request-clear();}
            }
            if !root.show-options : VerticalLayout {
                spacing: 0px; padding: 0px;
            Rectangle {
                height: 84px;
                    Text { x: 20px; y: 17px; height: 26px; text: "History"; font-size: 18px; font-weight: 600; color: #f0f1f6; }
                    Text { x: 20px; y: 47px; height: 16px; text: "\{root.captures.length}\{root.has-more ? "+" : ""} captures"; font-size: 10px; color: #818b9e; }
                    Rectangle {
                        x: parent.width - 124px; y: 25px;
                        width: 104px; height: 34px; border-radius: 7px;
                        background: capture-touch.pressed ? #122946 : capture-touch.has-hover ? #234774 : #162f55;
                        animate background { duration: 110ms; }
                        border-width: 1px; border-color: #335782;
                        Image { x: 11px; y: 10px; source: @image-url("icons/capture.svg"); width: 15px; height: 15px; colorize: #eef5ff; }
                        Text { x: 34px; y: 0px; height: parent.height; vertical-alignment: center; text: "Capture"; font-size: 12px; font-weight: 600; color: #eef5ff; }
                        capture-touch := TouchArea { clicked => { root.capture(); } }
                    }
                Rectangle {
                    x: parent.width - 236px; y: 25px; width: 104px; height: 34px; border-radius: 7px;
                    opacity: clear-touch.enabled ? 1 : 0.45;
                    border-width: 1px; border-color: clear-touch.has-hover ? #61404d : #354050;
                    background: clear-touch.pressed ? #4b2936 : clear-touch.has-hover ? #3b2631 : #1b222d;
                    animate background { duration: 110ms; }
                    Image { x: 10px; y: 11px; width: 12px; height: 12px; source: @image-url("icons/trash.svg"); colorize: clear-touch.has-hover ? #e2a1b6 : #aeb9cb; }
                    Text { x: 29px; y: 0px; width: parent.width - 37px; height: parent.height; text: "Clear history"; font-size: 10px; color: clear-touch.has-hover ? #e2a1b6 : #aeb9cb; horizontal-alignment: center; vertical-alignment: center; }
                    clear-touch := TouchArea {enabled: root.captures.length > 0 && !root.history-busy; clicked => {root.request-clear();}}
                }
            }
            if root.captures.length == 0 : Rectangle {
                vertical-stretch: 1;
                    Rectangle {
                        x: (parent.width - self.width) / 2; y: parent.height / 2 - 106px;
                        width: 66px; height: 66px; border-radius: 20px; background: #142338; border-color: #294263; border-width: 1px;
                        Image { source: @image-url("icons/image.svg"); width: 29px; height: 29px; x: 18px; y: 18px; colorize: #6e9fdf; }
                    }
                    Text { x: 20px; width: parent.width - 40px; y: parent.height / 2 - 20px; height: 24px; text: "Keep something worth keeping."; horizontal-alignment: center; font-size: 16px; font-weight: 600; color: #e5e8f0; }
                    Text { x: 20px; width: parent.width - 40px; y: parent.height / 2 + 16px; height: 38px; text: "Capture a detail, an idea, a little inspiration.\nFind it here whenever you need it."; horizontal-alignment: center; font-size: 12px; color: #818b9e; }
                    Text { y: parent.height / 2 + 72px; height: 22px; width: parent.width; horizontal-alignment: center; text: root.screenshot-hotkey; color: #9fbee6; font-size: 11px; }
            }
            if root.captures.length > 0 : ScrollView {
                content-width: self.width;
                property <int> selection: root.selected;
                changed selection => {
                    if self.selection >= 0 {
                        if floor(self.selection / 3) * 157px + self.content-y < 0px {
                            self.content-y = -floor(self.selection / 3) * 157px;
                        } else if floor(self.selection / 3) * 157px + 152px + self.content-y > self.height {
                            self.content-y = self.height - floor(self.selection / 3) * 157px - 152px;
                        }
                    }
                }
                VerticalLayout {
                    padding-left: 20px; padding-right: 20px; padding-top: 5px; padding-bottom: 16px; spacing: 10px;
                    for row in ceil(root.captures.length / 3) : HorizontalLayout {
                        spacing: 10px;
                        for col in 3 : Rectangle {
                            property <int> index: row * 3 + col;
                            property <bool> exists: self.index < root.captures.length;
                            height: 147px;
                            min-width: 0px;
                            preferred-width: 0px;
                            horizontal-stretch: 1;
                            border-radius: 9px;
                            background: self.exists ? (card-touch.has-hover ? #252a35 : #1b2029) : transparent;
                            border-width: 1px;
                            border-color: self.exists ? (root.selected == self.index ? #6e9fdf : card-touch.has-hover ? #596076 : #303642) : transparent;
                            animate border-color { duration: 100ms; }
                            if self.exists : Rectangle {
                                background: transparent;
                                Rectangle {
                                    x: 5px; y: 5px; width: parent.width - 10px;
                                    border-radius: 5px; background: #101318; height: 98px; clip: true;
                                    Image {
                                        x: 6px; y: 6px;
                                        width: parent.width - 12px;
                                        height: parent.height - 12px;
                                        source: root.captures[index].preview;
                                        image-fit: contain;
                                    }
                                    if root.captures[index].animated : Rectangle {
                                        x: 5px; y: 5px; width: 29px; height: 16px; border-radius: 4px; background: #522a39;
                                        Text { text: "GIF"; font-size: 9px; font-weight: 600; color: #ffdce4; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                }
                                Text { x: 8px; y: 110px; width: parent.width - 16px; height: 14px; text: root.captures[index].label; font-size: 10px; color: #d3d8e3; overflow: elide; }
                                Text { x: 8px; y: 128px; width: parent.width - 16px; height: 12px; text: root.captures[index].dimensions; font-size: 9px; color: #7d8799; overflow: elide; }
                            }
                            card-touch := TouchArea {
                                enabled: parent.exists && !root.history-busy;
                                clicked => { root.paste(parent.index); }
                                changed has-hover => {
                                    if self.has-hover && parent.exists && root.captures[parent.index].animated {
                                        root.hovered = parent.index; root.preview(parent.index);
                                    } else if !self.has-hover && root.hovered == parent.index {
                                        root.hovered = -1; root.preview(-1);
                                    }
                                }
                            }
                            if self.exists : Rectangle {
                                x: parent.width - 54px; y: 8px; width: 46px; height: 22px; z: 1;
                                background: transparent;
                                opacity: card-touch.has-hover || view-touch.has-hover || delete-touch.has-hover ? 1 : 0;
                                Rectangle {
                                    x: 0px; width: 21px; height: 22px; border-radius: 5px;
                                    background: view-touch.has-hover ? #294e7e : #182b43e0;
                                    Image {x: 4px; y: 4px; width: 13px; height: 14px; source: @image-url("icons/view.svg"); colorize: #c4ddff;}
                                    view-touch := TouchArea {enabled: !root.history-busy;mouse-cursor: pointer;clicked => {root.view-capture(index);}}
                                }
                                Rectangle {
                                x: 25px; width: 21px; height: 22px; border-radius: 5px;
                                background: delete-touch.has-hover ? #683646 : #29212be0;
                                Image { x: 4px; y: 4px; width: 13px; height: 14px; source: @image-url("icons/trash.svg"); colorize: #f5cad6; }
                                delete-touch := TouchArea {enabled: !root.history-busy;mouse-cursor: pointer;clicked => {root.request-delete(index);}}
                                }
                            }
                        }
                    }
                    if root.has-more : Rectangle {
                        height: 32px; border-radius: 6px; background: more-touch.has-hover ? #292f3b : #1c212a;
                        Text { text: "Load older captures"; horizontal-alignment: center; vertical-alignment: center; color: #a8b0c1; font-size: 11px; }
                        more-touch := TouchArea { clicked => { root.more(); } }
                    }
                }
            }
            }
            Rectangle { height: 1px; background: #262b34; }
            Rectangle {
                height: 40px;
                Rectangle { x: 22px; y: 17px; width: 5px; height: 5px; border-radius: 3px; background: #88c9a8; }
                Text { x: 33px; y: 10px; width: parent.width - 105px; height: 19px; vertical-alignment: center; text: root.status; font-size: 10px; color: #8b96a9; overflow: elide; }
                Text { x: parent.width - 57px; y: 10px; width: 35px; height: 19px; vertical-alignment: center; horizontal-alignment: right; text: root.release-version; color: #8294ae; font-size: 10px; }
            }
        }
    }
    if root.confirming : Rectangle {
        z: 100; background: #080b11c9;
        TouchArea {}
        Rectangle {
            x: 24px; y: (parent.height - self.height)/2; width: parent.width - 48px; height: 186px;
            border-radius: 12px; border-width: 1px; border-color: #61404d; background: #1a1e28;
            Text { x: 20px; y: 20px; height: 27px; text: root.clear-requested ? "Clear all history?" : "Delete this capture?"; color: #f4e7ed; font-size: 18px; font-weight: 600; }
            Text { x: 20px; y: 57px; width: parent.width - 40px; height: 48px; wrap: word-wrap; text: root.clear-requested ? "All saved screenshots, GIFs, and previews will be deleted. This cannot be undone." : "The saved capture and its preview will be deleted. This cannot be undone."; color: #a59cac; font-size: 12px; }
            HorizontalLayout {
                x: 20px; y: 126px; width: parent.width - 40px; height: 35px; spacing: 10px;
                Rectangle {
                    min-width: 0px; preferred-width: 0px; horizontal-stretch: 1; border-radius: 6px; background: cancel-delete.has-hover ? #354055 : #283244;
                    Text { text: "Cancel"; color: #ccd7e9; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                    cancel-delete := TouchArea {clicked => {root.confirming = false;}}
                }
                Rectangle {
                    min-width: 0px; preferred-width: 0px; horizontal-stretch: 1; border-radius: 6px; background: confirm-delete.has-hover ? #a84e67 : #813b50;
                    Text { text: root.clear-requested ? "Clear history" : "Delete"; color: #fff0f5; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                    confirm-delete := TouchArea {clicked => {root.accept-deletion();}}
                }
            }
        }
    }
}
